<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration, slug "installers" (copy of what is configured in SignPath).
     Input: the zip that .github/workflows/release.yml uploads from out/unsigned-installers/.
     The binaries inside were already signed in the "binaries" request; this signs the installers. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ErikAgentShield_${version}_x64-setup.exe" product-name="Erik’s AgentShield" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <msi-file path="ErikAgentShield_${version}_x64_en-US.msi" subject="Erik’s AgentShield" author="Erik van de Blaak">
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
