<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration, slug "binaries" (copy of what is configured in SignPath).
     Input: the zip that .github/workflows/release.yml uploads from out/unsigned-binaries/.
     The desktop binary comes twice, pre-patched per installer type (see scripts/release-windows.ps1). -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="Erik’s AgentShield" product-version="${version}">
      <include path="agentshield.exe" />
      <include path="agentshield-desktop-nsis.exe" />
      <include path="agentshield-desktop-msi.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
